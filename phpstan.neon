includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7
    parseModelCastsMethod: true

    ignoreErrors:
        -
            # Unmodified Sanctum-published config boilerplate — env()'s stub
            # return type includes bool because Laravel casts "true"/"false"
            # strings, not something to change in vendor-default config.
            message: '~Parameter #2 \$string of function explode expects string, bool\|string given\.~'
            path: config/sanctum.php
        -
            # Sanctum's PHPDoc types currentAccessToken() as a PersonalAccessToken,
            # but a first-party cookie (SPA/web) session gets a TransientToken at
            # runtime. The content-PIN grant is bound to a real Bearer token id, so
            # the instanceof check is required and must stay.
            identifier: instanceof.alwaysTrue
            path: app/Services/Privacy/ContentPin.php
            count: 2
