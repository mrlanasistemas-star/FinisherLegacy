APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): uncomment so the session cookie is only ever sent over
# HTTPS and can't be stolen on a plain-HTTP hop. Leave it off for local
# http:// development or you won't be able to stay signed in.
# SESSION_SECURE_COOKIE=true

# Minutes a mobile/API sign-in token lives (default 86400 = 60 days).
# SANCTUM_EXPIRATION_MINUTES=86400

# reverb (realtime) | log (see payloads in the log) | null (off). The app
# works with any of them; the web falls back to polling without Reverb.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Production: QUEUE_CONNECTION=redis, CACHE_STORE=redis + `php artisan horizon`
# (docs/DEPLOYMENT.md). Logical queues default to `default` locally.
# QUEUE_REALTIME=realtime
# QUEUE_MEDIA=media

# Laravel Reverb (php artisan reverb:start). Generate your own id/key/secret.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Mobile push: expo | null. EXPO_ACCESS_TOKEN only if EAS "enhanced push security" is on.
# PUSH_PROVIDER=expo
# EXPO_ACCESS_TOKEN=

# Structured JSON logs: LOG_STACK=daily,json

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# openpay|stripe — gateway of the web checkout (tienda). An admin can also
# change it, and the OpenPay keys, in /admin/configuracion/pagos (panel
# values override these; the private key is stored encrypted).
FINISHER_PAYMENT_GATEWAY=openpay

# OpenPay dashboard → Configuración → Llaves de API (sandbox keys while
# OPENPAY_PRODUCTION_MODE=false). Webhook URL: {APP_URL}/api/webhooks/openpay
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_PUBLIC_KEY=
OPENPAY_COUNTRY=MX
OPENPAY_PRODUCTION_MODE=false
# true = every card charge goes through 3D Secure. false = only a charge
# rejected by OpenPay's anti-fraud (error 3005) is retried once with 3DS.
OPENPAY_USE_3D_SECURE=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Gateway for /api/v1 (mobile app, Stripe PaymentSheet) when the client does not pick one.
FINISHER_API_PAYMENT_GATEWAY=stripe
FINISHER_MERCHANT_DISPLAY_NAME="Finisher Legacy"

# Native sign-in (comma-separated client ids). Empty = provider disabled.
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_SIGNIN_CLIENT_IDS=

# Memory Packs (extra event media). Keep false until a real product exists.
FINISHER_MEMORY_PACKS_ENABLED=false

# Athlete event media (photos/videos) — defaults shown are what
# config/finisher.php falls back to when unset.
# FINISHER_MEDIA_FREE_IMAGES=5
# FINISHER_MEDIA_FREE_VIDEOS=1
# FINISHER_MEDIA_MAX_IMAGE_BYTES=8388608
# FINISHER_MEDIA_MAX_VIDEO_BYTES=104857600
# FINISHER_MEDIA_DISK=athlete_media

# "Mi equipo de apoyo" supporter audio messages.
# FINISHER_SUPPORT_AUDIO_MAX_SECONDS=60
# FINISHER_SUPPORT_AUDIO_MAX_BYTES=10485760
# FINISHER_SUPPORT_AUDIO_DISK=support_audio

# Store product gallery uploads (Admin\ProductMediaController).
# FINISHER_PRODUCT_MEDIA_DISK=product_media

# Media pipeline + Synology (docs/SYNOLOGY.md). Leave FINISHER_MEDIA_ROOT
# empty in dev (media goes to the private local disk). In production point
# it at the OS-level NFS/SMB mount of the Synology share (over Tailscale).
# Never commit hosts, IPs or credentials.
# FINISHER_MEDIA_ROOT=
# FINISHER_MEDIA_DRIVER=local
# FINISHER_MEDIA_STORAGE_DISK=
# FINISHER_MEDIA_TMP_ROOT=
# FINISHER_MEDIA_QUEUE=default
# FINISHER_MEDIA_CDN_URL=
# FFMPEG_BINARY=
# FFPROBE_BINARY=
# Auto-detected from PATH when empty (sudo apt install ffmpeg). Audio: real duration + AAC/m4a re-encode.
# FFMPEG_PATH_LOOKUP=true
# FINISHER_MEDIA_AUDIO_TRANSCODE=true
# FINISHER_MEDIA_AUDIO_BITRATE_KBPS=80
# NFC / mobile app links (docs/NFC.md §5) — leave empty to disable
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.finisherlegacy.app
IOS_APP_STORE_ID=
ANDROID_APP_PACKAGE=com.finisherlegacy.app
ANDROID_SHA256_CERT_FINGERPRINTS=
MOBILE_APP_SCHEME=finisherlegacy
NFC_TAP_RETENTION_DAYS=90

# Storage health probe (php artisan storage:health, scheduled every 10 min;
# docs/renovacion/synology-smb.md). Production example: FINISHER_MEDIA_ROOT=/mnt/fl-media,
# FINISHER_MEDIA_SENTINEL=.fl-media-mounted (file created once on the NAS share),
# FINISHER_MEDIA_REQUIRE_MOUNT=true. STORAGE_HEALTH_DISKS empty = media + temp disks.
# STORAGE_HEALTH_DISKS=
# STORAGE_HEALTH_MIN_FREE_MB=2048
# FINISHER_MEDIA_SENTINEL=
# FINISHER_MEDIA_REQUIRE_MOUNT=false

# In-app purchases of photo expansions (StoreKit 2 / Google Play Billing) —
# docs/renovacion/compras-dentro-de-app.md. Empty = the app endpoints answer
# 503 IAP_NOT_CONFIGURED and the app hides "Ampliar espacio".
# App Store Connect → Users and Access → Integrations → In-App Purchase key.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# The .p8 contents (with \n) or an absolute path to the .p8 file.
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.finisherlegacy.app
# APPLE_APP_APPLE_ID=
# APPLE_IAP_ALLOW_SANDBOX=true
# Notifications V2 URL (App Store Connect → App Information): {APP_URL}/api/webhooks/app-store
# Absolute path to the Play Console service-account JSON key (never commit it).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.finisherlegacy.app
# RTDN Pub/Sub push to {APP_URL}/api/webhooks/google-play — OIDC (preferred) or ?token=.
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=
GOOGLE_PLAY_RTDN_TOKEN=

# ── Idiomas y traducciones (docs/renovacion/idiomas.md) ──────────────────
# Languages come from config/i18n.php; optional override, comma separated.
# APP_SUPPORTED_LOCALES=es,en
# Machine translator used by `php artisan i18n:sync`: anthropic | deepl | null.
# `null` (default) translates nothing: new texts stay pending in Spanish.
I18N_TRANSLATOR=null
# Claude model for translations (exact id). Alternatives, cheaper and
# faster: claude-sonnet-5-5, claude-haiku-5-5.
# I18N_ANTHROPIC_MODEL=claude-opus-5-5
# I18N_ANTHROPIC_EFFORT=low
ANTHROPIC_API_KEY=
DEEPL_API_KEY=
# Where the mobile project's `src` folder is (dev machines only).
# I18N_MOBILE_PATH=../FinisherLegacyMobile/src
# Read the browser's Accept-Language when the visitor has not chosen.
# I18N_DETECT_BROWSER=true
