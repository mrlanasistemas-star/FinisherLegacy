APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# openpay|stripe — which PaymentGateway CreateOnlinePayment uses by default.
FINISHER_PAYMENT_GATEWAY=openpay

OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_PUBLIC_KEY=
OPENPAY_COUNTRY=MX
OPENPAY_PRODUCTION_MODE=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Athlete event media (photos/videos) — defaults shown are what
# config/finisher.php falls back to when unset.
# FINISHER_MEDIA_FREE_IMAGES=5
# FINISHER_MEDIA_FREE_VIDEOS=1
# FINISHER_MEDIA_MAX_IMAGE_BYTES=8388608
# FINISHER_MEDIA_MAX_VIDEO_BYTES=104857600
# FINISHER_MEDIA_DISK=athlete_media

# "Mi equipo de apoyo" supporter audio messages.
# FINISHER_SUPPORT_AUDIO_MAX_SECONDS=60
# FINISHER_SUPPORT_AUDIO_MAX_BYTES=10485760
# FINISHER_SUPPORT_AUDIO_DISK=support_audio

# Store product gallery uploads (Admin\ProductMediaController).
# FINISHER_PRODUCT_MEDIA_DISK=product_media
